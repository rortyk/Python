{
	"folders": [
		{
			"name": "Python (root)",
			"path": "."
		},
		{
			"name": "basics",
			"path": "basics"
		}
	],
	"settings": {
		// VSCode内でターミナルを開くと自動で venv を activate する
		"python.terminal.activateEnvironment": true,

		// 各フォルダ直下の .venv を使う（${workspaceFolder} はファイルが属するルートに展開される）
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

		// 独立ルートとして表示済みのフォルダを Python (root) 側から隠し、重複表示を防ぐ
		"files.exclude": {
			"basics": true
		}
	}
}
